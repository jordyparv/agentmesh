# Postgres. Dev default: the embedded PGlite server (`pnpm db:serve`). Production: docker compose.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# Worktrees, scratch dirs, embedded DB data.
AGENTMESH_DATA_DIR=./.data
API_HOST=127.0.0.1
API_PORT=4000
# URL agents use (from inside the sandbox) to reach the API for collaboration tools.
AGENTMESH_API_URL=http://127.0.0.1:4000
# Colon-separated roots that registered repositories must live under (recommended).
AGENTMESH_ALLOWED_REPO_ROOTS=
# Sandbox for agent + validation processes: bwrap | none (unsafe)
AGENTMESH_SANDBOX=bwrap
# Worker
AGENTMESH_WORKER_ID=
AGENTMESH_WORKER_PARALLEL=4
# Enables the SIMULATED test adapter (tests/demos only).
AGENTMESH_ENABLE_TEST_ADAPTER=0
LOG_LEVEL=info
# Portal (apps/web/.env.local, written by `pnpm agentmesh bootstrap`; server-side only)
# AGENTMESH_API_URL=http://127.0.0.1:4000
# AGENTMESH_API_TOKEN=am_...
