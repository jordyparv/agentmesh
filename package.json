{
  "name": "agentmesh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "agentmesh": "tsx apps/cli/src/index.ts",
    "build:mcp": "tsx packages/mcp-server/src/build.ts",
    "build:web": "pnpm --filter @agentmesh/web build",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "tsx apps/cli/src/index.ts db migrate",
    "db:serve": "tsx apps/cli/src/index.ts db serve",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "pnpm --filter @agentmesh/web dev",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "start:web": "pnpm --filter @agentmesh/web start",
    "test": "vitest run",
    "test:e2e": "pnpm build:web && playwright test -c tests/e2e/playwright.config.ts",
    "test:live": "AGENTMESH_LIVE=1 vitest run tests/live",
    "token:create": "tsx apps/cli/src/index.ts token create",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @agentmesh/web typecheck"
  },
  "devDependencies": {
    "@agentmesh/adapter-antigravity": "workspace:*",
    "@agentmesh/adapter-claude": "workspace:*",
    "@agentmesh/adapter-codex": "workspace:*",
    "@agentmesh/adapter-test": "workspace:*",
    "@agentmesh/api": "workspace:*",
    "@agentmesh/contracts": "workspace:*",
    "@agentmesh/database": "workspace:*",
    "@agentmesh/engine-kernel": "workspace:*",
    "@agentmesh/execution-runtime": "workspace:*",
    "@agentmesh/mcp-server": "workspace:*",
    "@agentmesh/observability": "workspace:*",
    "@agentmesh/shared-memory": "workspace:*",
    "@agentmesh/validation-engine": "workspace:*",
    "@agentmesh/workspace-manager": "workspace:*",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
